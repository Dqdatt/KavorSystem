{
  "name": "kavor-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "pnpm --filter @kavor/admin-web dev",
    "dev:console": "pnpm --filter @kavor/console-web dev",
    "dev:api": "pnpm --filter @kavor/api dev",
    "dev:mobile": "pnpm --filter @kavor/mobile start",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.48.3",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  }
}
