# Sao chép thành .env và điền giá trị thật. Không commit .env.
NODE_ENV=development
API_PORT=4000
# Danh sách origin web được gọi API, phân tách bằng dấu phẩy
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Link cài app nhân viên (PWA, sau này App Store/Google Play); để trống = không hiện trong mail mời. Production phải là https.
MOBILE_IOS_URL=
MOBILE_ANDROID_URL=
# Web Push cho PWA nhân viên: tạo khóa bằng `cd apps/api && npx web-push generate-vapid-keys`; để trống = tắt push.
# SUBJECT là mailto:/https:// tên miền thật (Apple từ chối .test/.local). tools/dev-backend.sh tự tạo khóa dev vào apps/api/.env.local.
API_VAPID_PUBLIC_KEY=
API_VAPID_PRIVATE_KEY=
API_VAPID_SUBJECT=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Supabase local (`supabase start`) chạy ở cổng 553xx; lấy key bằng `supabase status -o env`.
# Staging: lấy URL/key trong Supabase Dashboard → Project Settings → API.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
