# Sao chép thành .env và điền giá trị thật. Không commit .env.
NODE_ENV=development
API_PORT=4000
# Danh sách origin web được gọi API, phân tách bằng dấu phẩy
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Supabase local (`supabase start`) chạy ở cổng 553xx; lấy key bằng `supabase status -o env`.
# Staging: lấy URL/key trong Supabase Dashboard → Project Settings → API.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
