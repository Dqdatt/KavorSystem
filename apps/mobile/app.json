{
  "expo": {
    "name": "Kavor",
    "slug": "kavor-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kavor",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "vn.kavor.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kavor dùng vị trí khi bạn chấm công để xác minh địa điểm làm việc.",
        "NSFaceIDUsageDescription": "Kavor dùng Face ID để mở khóa phiếu lương, tạm ứng và đăng nhập nhanh."
      }
    },
    "android": {
      "package": "vn.kavor.mobile",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#065F46"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#065F46"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kavor dùng Face ID để mở khóa phiếu lương, tạm ứng và đăng nhập nhanh."
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/@expo-google-fonts/montserrat/300Light/Montserrat_300Light.ttf",
              "./node_modules/@expo-google-fonts/montserrat/400Regular/Montserrat_400Regular.ttf",
              "./node_modules/@expo-google-fonts/montserrat/500Medium/Montserrat_500Medium.ttf",
              "./node_modules/@expo-google-fonts/montserrat/600SemiBold/Montserrat_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/montserrat/700Bold/Montserrat_700Bold.ttf",
              "./node_modules/@expo-google-fonts/montserrat/800ExtraBold/Montserrat_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ]
  }
}
